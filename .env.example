# PostgreSQL local (docker compose)
DATABASE_URL="postgresql://preplab:preplab@localhost:5432/asvab?schema=public"

# Segredo para o cookie de sessão (troque em produção; mínimo de 32 caracteres)
AUTH_SECRET="troque-este-segredo-por-uma-string-longa-e-aleatoria"

# URL pública usada em metadados canônicos
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Defina como true somente atrás de HTTPS. Em http://localhost deixe ausente.
# COOKIE_SECURE="true"
